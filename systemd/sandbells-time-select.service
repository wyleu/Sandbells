[Unit]
Description=Sandbells ensure chrony sources from time_hosts (settings.json)
After=network-online.target NetworkManager.service
Wants=network-online.target
# Run after chrony exists so restart is valid; sources.d is read on start too
After=chrony.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sandbells-time-select.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
