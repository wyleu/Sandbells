\version "2.24.1"
\language "english"
#(set-global-staff-size 48)
% DRAFT generated by zss2ly.py from a zynseq snapshot. Joined from little-donkey-a.zss, sequences 0,32,64,96,128.
% Bell numbers: F5=1 E5=2 D5=3 C5=4 Bb4=5 A4=6 G4=7 F4=8.

\header {
    title = "Little Donkey"
    tagline = "Sandbells"
}
% Bell colours from the Sandbells front page,
% changes/bells/static/js/bell_band.js  BELL_COLOURS
% (this copy: /workspace/chimes-work/Sandbells/changes/bells/static/js/bell_band.js).
% Coloured by bell number (pitch and octave), so F5 and F4 differ.
#(define color-mapping
   (list
    (cons (ly:make-pitch 1 3 NATURAL) (rgb-color (/ 255 255) (/ 32 255) (/ 32 255))) ; bell 1 F5 #ff2020
    (cons (ly:make-pitch 1 2 NATURAL) (rgb-color (/ 255 255) (/ 140 255) (/ 0 255))) ; bell 2 E5 #ff8c00
    (cons (ly:make-pitch 1 1 NATURAL) (rgb-color (/ 255 255) (/ 208 255) (/ 0 255))) ; bell 3 D5 #ffd000
    (cons (ly:make-pitch 1 0 NATURAL) (rgb-color (/ 34 255) (/ 192 255) (/ 34 255))) ; bell 4 C5 #22c022
    (cons (ly:make-pitch 0 6 FLAT) (rgb-color (/ 0 255) (/ 212 255) (/ 212 255))) ; bell 5 Bb4 #00d4d4
    (cons (ly:make-pitch 0 5 NATURAL) (rgb-color (/ 32 255) (/ 80 255) (/ 255 255))) ; bell 6 A4 #2050ff
    (cons (ly:make-pitch 0 4 NATURAL) (rgb-color (/ 224 255) (/ 0 255) (/ 224 255))) ; bell 7 G4 #e000e0
    (cons (ly:make-pitch 0 3 NATURAL) (rgb-color (/ 139 255) (/ 0 255) (/ 0 255))) ; bell 8 F4 #8b0000
    ))
#(define (pitch-to-color pitch)
   (let ((color (assoc pitch color-mapping equal?)))
     (if color (cdr color))))

#(define (color-notehead grob)
   (pitch-to-color
    (ly:event-property (event-cause grob) 'pitch)))

\paper {
  #(set-paper-size "a4landscape")
  page-count = 1
  ragged-bottom = ##f
  ragged-last-bottom = ##f
}

tune = {
  \override NoteHead.color = #color-notehead
  \clef treble
  \key f \major
  \numericTimeSignature \time 4/4
   a'8 a'8 c''4 a'4 bf'8 bf'8 |
    d''4 bf'4 a'8 a'8 c''4 |
    a'4 g'2. |
    a'8 a'8 c''4 a'4 bf'8 bf'8 |
    d''4 bf'4 c''8 c''8 e''4 |
    c''4 <f' f''>2. |
    f''4 f''8 f''8 e''8 d''8 c''4 |
    d''8 e''16 d''16 c''4 d''8 e''16 d''16 c''4 |
    a'8 a'8 c''4 a'4 bf'8 bf'8 |
    d''4 bf'4 a'8 a'8 c''4 |
    a'4 g'2. |
    a'8 a'8 c''4 a'4 bf'8 bf'8 |
    d''4 bf'4 c''8 c''8 e''4 |
    c''4 <f' f''>2. |
  \bar "|."
}

\score {
  <<
  \new Staff = "bells" \with {
  instrumentName = "Bells"
  midiInstrument = "tubular bells"
  }
  \new Voice = "bells" \tune
  \new Lyrics \with { alignAboveContext = "bells" } {
    \lyricsto "bells" {
      "6" "6" "4" "6" "5" "5" "3" "5" "6" "6" "4" "6" "7" "6" "6" "4" "6" "5" "5" "3" "5" "4" "4" "2" "4" "1/8" "1" "1" "1" "2" "3" "4" "3" "2" "3" "4" "3" "2" "3" "4" "6" "6" "4" "6" "5" "5" "3" "5" "6" "6" "4" "6" "7" "6" "6" "4" "6" "5" "5" "3" "5" "4" "4" "2" "4" "1/8"
    }
  }
  >>
  \layout { }
}
\score {
  \unfoldRepeats { \tune }
  \midi {
    \tempo 4=70
  }
}
